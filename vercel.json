{
  "headers": [
    {
      "source": "/(assets|css|js|data)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/submit-lead", "destination": "/api/submit-lead.js" },
    { "source": "/coworking/:city*", "destination": "/index.html" },
    { "source": "/office/:city*", "destination": "/index.html" },
    { "source": "/thank-you", "destination": "/thank-you.html" }
  ]
}
